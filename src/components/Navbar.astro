---
import { withBase, appHref } from '../utils/assets';
import { app } from '../data/app';

const links = [
  { href: '#caracteristicas', label: 'Características', en: 'Features' },
  { href: '#descargas', label: 'Descargas', en: 'Downloads' },
  { href: '#como-funciona', label: 'Cómo funciona', en: 'How it works' },
  { href: '#personalizacion', label: 'Personalización', en: 'Personalization' },
  { href: '#comunidad', label: 'Comunidad', en: 'Community' },
  { href: '#roadmap', label: 'Roadmap', en: 'Roadmap' },
];
---

<header class="site-nav" data-nav>
  <nav class="mx-auto flex h-16 max-w-7xl items-center justify-between gap-4 px-5 sm:px-8" aria-label="Navegación principal">
    <a href="#inicio" class="flex shrink-0 items-center gap-2.5" aria-label={`${app.name} — Inicio`}>
      <img src={withBase('logo.png')} alt="" class="h-9 w-9 rounded-xl" />
      <span class="text-[15px] font-extrabold tracking-[-0.03em] text-white">{app.name}</span>
    </a>

    <div class="hidden items-center gap-7 text-[13px] font-medium text-white/60 lg:flex">
      {
        links.map((link) => (
          <a href={link.href} class="nav-link" data-en={link.en}>{link.label}</a>
        ))
      }
    </div>

    <div class="flex items-center gap-2">
      <button
        type="button"
        class="lang-pill"
        data-lang
        aria-label="Cambiar idioma / Change language"
        title="Cambiar idioma"
      >ES</button>

      <a
        href={appHref(app.apkUrl)}
        download="MisCanciones.apk"
        class="cta-pill hidden sm:inline-flex"
        data-en="Download APK"
      >Descargar APK</a>

      <button
        type="button"
        class="menu-toggle lg:hidden"
        data-menu-toggle
        aria-expanded="false"
        aria-controls="mobile-menu"
        aria-label="Abrir menú"
      >
        <span></span><span></span>
      </button>
    </div>
  </nav>

  <div class="mobile-menu lg:hidden" id="mobile-menu" data-menu hidden>
    {
      links.map((link) => (
        <a href={link.href} data-en={link.en}>{link.label}</a>
      ))
    }
    <a href={appHref(app.apkUrl)} download="MisCanciones.apk" data-en="Download APK">Descargar APK</a>
  </div>
</header>
