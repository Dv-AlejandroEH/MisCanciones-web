---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import Dock from '../components/Dock.astro';
import Hero from '../components/Hero.astro';
import BentoGrid from '../components/BentoGrid.astro';
import Scrollytelling from '../components/Scrollytelling.astro';
import InteractiveDemo from '../components/InteractiveDemo.astro';
import Community from '../components/Community.astro';
import Footer from '../components/Footer.astro';
import { app } from '../data/app';
import { withBase, appHref } from '../utils/assets';

const site = Astro.site ?? new URL(Astro.url.origin);
const siteUrl = site.toString().replace(/\/$/, '');
const apkUrl = new URL(appHref(app.apkUrl), site).toString();
const imageUrl = new URL(withBase('og-image.png'), site).toString();

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: app.name,
  applicationCategory: 'MusicApplication',
  operatingSystem: 'Android, Web',
  description: `${app.description} ${app.valueProposition}`,
  url: app.webUrl,
  downloadUrl: apkUrl,
  softwareVersion: app.version,
  image: imageUrl,
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'EUR' },
  featureList: [
    'Búsqueda de canciones, artistas, álbumes y podcasts',
    'Biblioteca personal y playlists',
    'Escucha sin conexión',
    'Interfaz en español e inglés',
  ],
  author: { '@type': 'Organization', name: app.name, url: siteUrl },
};
---

<BaseLayout
  title={`${app.name} — ${app.tagline}`}
  description={app.valueProposition}
  structuredData={structuredData}
>
  <Navbar />
  <main>
    <Hero />
    <BentoGrid />
    <Scrollytelling />
    <InteractiveDemo />
    <Community />
  </main>
  <Footer />
  <Dock />
</BaseLayout>
