---
import BaseLayout from '../layouts/BaseLayout.astro';

const siteUrl = (Astro.site ?? new URL(Astro.url.origin)).toString().replace(/\/$/, '');
const year = new Date().getFullYear();

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'Mis Canciones',
  applicationCategory: 'MusicApplication',
  operatingSystem: 'Android, Windows, macOS',
  description:
    'Aplicación de música en streaming con reproducción rápida, audio de alta calidad, modo sin conexión, sin anuncios y listas inteligentes.',
  url: siteUrl,
  downloadUrl: `${siteUrl}/#descargar`,
  softwareVersion: '2.0',
  image: `${siteUrl}/og-image.png`,
  offers: {
    '@type': 'Offer',
    price: '0',
    priceCurrency: 'USD',
    availability: 'https://schema.org/InStock',
  },
  featureList: [
    'Audio de alta calidad',
    'Modo sin conexión',
    'Reproducción sin anuncios',
    'Listas de reproducción inteligentes',
  ],
  author: {
    '@type': 'Organization',
    name: 'Mis Canciones',
    url: siteUrl,
  },
};

const features = [
  {
    title: 'Audio de alta calidad',
    description: 'Sonido sin pérdida y hasta 24-bit/192 kHz para escuchar cada detalle de tus canciones favoritas.',
    paths: ['M22 12h-4l-3 9L9 3l-3 9H2'],
  },
  {
    title: 'Modo sin conexión',
    description: 'Guarda álbumes y listas completas en tu dispositivo y sigue escuchando incluso sin internet.',
    paths: ['M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4', 'm7 10 5 5 5-5', 'M12 15V3'],
  },
  {
    title: 'Sin interrupciones',
    description: 'Cero anuncios, cero cortes. Reproducción continua y transiciones perfectas entre canciones.',
    paths: [
      'M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z',
      'm9 12 2 2 4-4',
    ],
  },
  {
    title: 'Listas inteligentes',
    description: 'Descubre música nueva y crea listas automáticas que se adaptan a tu gusto y a tu momento.',
    paths: [
      'm12 3-1.9 5.8a2 2 0 0 1-1.3 1.3L3 12l5.8 1.9a2 2 0 0 1 1.3 1.3L12 21l1.9-5.8a2 2 0 0 1 1.3-1.3L21 12l-5.8-1.9a2 2 0 0 1-1.3-1.3L12 3Z',
      'M5 3v4',
      'M3 5h4',
      'M19 17v4',
      'M17 19h4',
    ],
  },
];

const tracks = [
  { title: 'Midnight Drive', artist: 'Neon Waves', time: '3:42', gradient: 'linear-gradient(135deg,#34d399,#0ea5e9)' },
  { title: 'Ciudad de luces', artist: 'Aurora V.', time: '4:18', gradient: 'linear-gradient(135deg,#a855f7,#f43f5e)' },
  { title: 'Otro amanecer', artist: 'Los Ecos', time: '2:57', gradient: 'linear-gradient(135deg,#f59e0b,#a855f7)' },
];

const requirements = [
  { platform: 'Android', detail: 'Android 8.0 o superior · 4 GB RAM' },
  { platform: 'Windows', detail: 'Windows 10/11 · 4 GB RAM' },
  { platform: 'macOS', detail: 'macOS 12 o superior' },
  { platform: 'Espacio', detail: '150 MB libres para instalar' },
];

const faqs = [
  {
    question: '¿Mis Canciones es realmente gratis?',
    answer: 'Sí. Puedes descargar la aplicación y escuchar sin anuncios de forma gratuita. Algunas funciones premium opcionales pueden estar disponibles más adelante.',
  },
  {
    question: '¿Puedo escuchar música sin conexión?',
    answer: 'Sí. Guarda canciones, álbumes o listas completas desde la app y reprodúcelas cuando no tengas internet o estés de viaje.',
  },
  {
    question: '¿En qué dispositivos funciona?',
    answer: 'La aplicación está disponible para Android, Windows y macOS. La versión para iOS está en preparación.',
  },
  {
    question: '¿Necesito una cuenta para usarla?',
    answer: 'No. Puedes empezar a escuchar de inmediato sin registro. Si quieres sincronizar tu biblioteca entre dispositivos, podrás crear una cuenta más adelante.',
  },
  {
    question: '¿Cómo instalo la aplicación?',
    answer: 'Pulsa cualquiera de los botones de descarga, elige el instalador de tu plataforma y sigue las instrucciones. El proceso tarda menos de un minuto.',
  },
];
---

<BaseLayout structuredData={structuredData}>
  <!-- Navbar -->
  <header class="sticky top-0 z-50 border-b border-white/5 bg-ink-950/75 backdrop-blur-xl">
    <nav class="mx-auto flex h-16 max-w-6xl items-center justify-between gap-4 px-5 sm:px-8" aria-label="Navegación principal">
      <a href="/" class="flex shrink-0 items-center gap-2.5" aria-label="Mis Canciones — Inicio">
        <span class="grid h-9 w-9 place-items-center rounded-xl bg-gradient-to-br from-mint-400 to-violet-neon shadow-lg shadow-mint-400/20">
          <svg viewBox="0 0 24 24" class="h-5 w-5 text-ink-950" fill="currentColor" aria-hidden="true">
            <path d="M19 3v12.5a3.5 3.5 0 1 1-2-3.16V7l-8 2v9.5a3.5 3.5 0 1 1-2-3.16V6l11-3Z" />
          </svg>
        </span>
        <span class="text-[15px] font-semibold tracking-tight text-white">Mis Canciones</span>
      </a>

      <div class="hidden items-center gap-8 text-sm text-slate-400 md:flex">
        <a href="#caracteristicas" class="transition-colors hover:text-white">Características</a>
        <a href="#descargar" class="transition-colors hover:text-white">Descargas</a>
        <a href="#faq" class="transition-colors hover:text-white">Preguntas frecuentes</a>
      </div>

      <a
        href="#descargar"
        class="inline-flex shrink-0 items-center gap-2 rounded-full bg-gradient-to-r from-mint-400 to-violet-neon px-4 py-2 text-sm font-semibold text-ink-950 shadow-lg shadow-mint-400/15 transition hover:brightness-110"
      >
        Descargar
      </a>
    </nav>
  </header>

  <main>
    <!-- Hero -->
    <section class="relative overflow-hidden pb-20 pt-16 sm:pt-24 lg:pb-28 lg:pt-28">
      <div class="pointer-events-none absolute left-1/2 top-0 -z-10 h-[420px] w-[820px] -translate-x-1/2 rounded-full bg-violet-neon/10 blur-[120px]"></div>

      <div class="mx-auto grid max-w-6xl items-center gap-16 px-5 sm:px-8 lg:grid-cols-[1.05fr_0.95fr] lg:gap-12">
        <div>
          <span class="inline-flex items-center gap-2 rounded-full border border-mint-400/25 bg-mint-400/10 px-3 py-1 text-xs font-medium text-mint-300">
            <span class="h-1.5 w-1.5 animate-glow rounded-full bg-mint-400"></span>
            Versión 2.0 ya disponible
          </span>

          <h1 class="mt-6 text-4xl font-bold leading-[1.08] tracking-tight text-white sm:text-5xl lg:text-6xl">
            Tu música, <span class="text-gradient">sin límites.</span>
          </h1>

          <p class="mt-5 max-w-xl text-base leading-relaxed text-slate-400 sm:text-lg">
            Streaming rápido, calidad de sonido superior y cero anuncios. Mis Canciones pone toda tu biblioteca en un solo lugar, siempre lista para sonar.
          </p>

          <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:items-center">
            <a
              href="#descargar"
              class="inline-flex items-center justify-center gap-2 rounded-full bg-gradient-to-r from-mint-400 to-violet-neon px-6 py-3.5 text-sm font-semibold text-ink-950 shadow-xl shadow-mint-400/20 transition hover:-translate-y-0.5 hover:brightness-110"
            >
              Descargar para Android / Desktop
              <svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M5 12h14m-6-6 6 6-6 6" />
              </svg>
            </a>
            <a
              href="#caracteristicas"
              class="inline-flex items-center justify-center rounded-full border border-white/10 bg-white/5 px-6 py-3.5 text-sm font-semibold text-slate-200 transition hover:border-white/20 hover:bg-white/10"
            >
              Ver características
            </a>
          </div>

          <ul class="mt-8 flex flex-wrap gap-x-6 gap-y-3 text-sm text-slate-400">
            <li class="flex items-center gap-2">
              <svg viewBox="0 0 24 24" class="h-4 w-4 text-mint-400" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m5 13 4 4L19 7" /></svg>
              Sin anuncios
            </li>
            <li class="flex items-center gap-2">
              <svg viewBox="0 0 24 24" class="h-4 w-4 text-mint-400" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m5 13 4 4L19 7" /></svg>
              Sin registro
            </li>
            <li class="flex items-center gap-2">
              <svg viewBox="0 0 24 24" class="h-4 w-4 text-mint-400" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m5 13 4 4L19 7" /></svg>
              Escucha offline
            </li>
          </ul>
        </div>

        <!-- Mockup de la aplicación -->
        <div class="relative mx-auto w-full max-w-[390px]" aria-label="Vista previa de la interfaz de Mis Canciones" role="img">
          <div class="absolute -inset-10 -z-10 rounded-full bg-violet-neon/15 blur-3xl animate-glow"></div>
          <div class="absolute -inset-4 -z-10 rounded-[3rem] bg-gradient-to-br from-mint-400/20 to-violet-neon/20 blur-2xl"></div>

          <div class="animate-float rounded-[2.5rem] border border-white/10 bg-ink-900/95 p-2.5 shadow-[0_45px_90px_-30px_rgba(0,0,0,0.95)]">
            <div class="overflow-hidden rounded-[2rem] bg-gradient-to-b from-[#121a29] to-[#070a11] p-5">
              <!-- Barra de estado -->
              <div class="flex items-center justify-between text-[10px] font-medium text-slate-400">
                <span>9:41</span>
                <div class="flex items-center gap-1.5">
                  <svg viewBox="0 0 24 24" class="h-3 w-3" fill="currentColor" aria-hidden="true"><path d="M2 17h3v4H2zm5-4h3v8H7zm5-4h3v12h-3zm5-5h3v17h-3z" /></svg>
                  <svg viewBox="0 0 24 24" class="h-3 w-3" fill="currentColor" aria-hidden="true"><path d="M12 3a9 9 0 0 0-9 9h3a6 6 0 0 1 12 0h3a9 9 0 0 0-9-9Zm0 5a4 4 0 0 0-4 4h2a2 2 0 0 1 4 0h2a4 4 0 0 0-4-4Zm-2 8h4l-2 5-2-5Z" /></svg>
                  <span class="h-2 w-4 rounded-sm border border-slate-500 bg-slate-500/60"></span>
                </div>
              </div>

              <!-- Cabecera -->
              <div class="mt-6 flex items-center justify-between">
                <div>
                  <p class="text-[11px] text-slate-500">Buenas noches</p>
                  <p class="text-lg font-semibold text-white">Escucha de nuevo</p>
                </div>
                <span class="grid h-9 w-9 place-items-center rounded-full bg-gradient-to-br from-mint-400 to-violet-neon text-xs font-bold text-ink-950">A</span>
              </div>

              <!-- Reproduciendo ahora -->
              <div class="mt-5 rounded-2xl border border-white/10 bg-white/5 p-3.5">
                <div class="flex items-center gap-3.5">
                  <div class="grid h-16 w-16 shrink-0 place-items-center rounded-xl bg-gradient-to-br from-mint-400 via-emerald-500 to-violet-neon shadow-lg shadow-mint-400/20">
                    <svg viewBox="0 0 24 24" class="h-7 w-7 text-ink-950/80" fill="currentColor" aria-hidden="true"><path d="M19 3v12.5a3.5 3.5 0 1 1-2-3.16V7l-8 2v9.5a3.5 3.5 0 1 1-2-3.16V6l11-3Z" /></svg>
                  </div>
                  <div class="min-w-0">
                    <p class="truncate text-sm font-semibold text-white">Midnight Drive</p>
                    <p class="truncate text-xs text-slate-400">Neon Waves</p>
                    <span class="mt-1.5 inline-flex items-center gap-1 rounded-full bg-mint-400/10 px-2 py-0.5 text-[9px] font-semibold uppercase tracking-wide text-mint-300">Hi-Fi 24-bit</span>
                  </div>
                </div>

                <div class="mt-4 h-1 overflow-hidden rounded-full bg-white/10">
                  <div class="h-full w-[38%] rounded-full bg-gradient-to-r from-mint-400 to-violet-neon"></div>
                </div>
                <div class="mt-1.5 flex justify-between text-[9px] text-slate-500"><span>1:24</span><span>3:42</span></div>

                <div class="mt-3 flex items-center justify-between text-slate-300">
                  <svg viewBox="0 0 24 24" class="h-3.5 w-3.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M16 3h5v5M4 20 21 3M21 16v5h-5M15 15l6 6M4 4l5 5" /></svg>
                  <svg viewBox="0 0 24 24" class="h-4 w-4" fill="currentColor" aria-hidden="true"><path d="M6 5v14l10-7L6 5Zm11 0h2v14h-2z" /></svg>
                  <span class="grid h-10 w-10 place-items-center rounded-full bg-gradient-to-br from-mint-400 to-violet-neon text-ink-950 shadow-lg shadow-mint-400/25">
                    <svg viewBox="0 0 24 24" class="h-4 w-4 translate-x-px" fill="currentColor" aria-hidden="true"><path d="M7 4v16l13-8L7 4Z" /></svg>
                  </span>
                  <svg viewBox="0 0 24 24" class="h-4 w-4" fill="currentColor" aria-hidden="true"><path d="M18 5v14L8 12l10-7ZM4 5h2v14H4z" /></svg>
                  <svg viewBox="0 0 24 24" class="h-3.5 w-3.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M17 2l4 4-4 4M3 11V9a4 4 0 0 1 4-4h14M7 22l-4-4 4-4M21 13v2a4 4 0 0 1-4 4H3" /></svg>
                </div>
              </div>

              <!-- Lista reciente -->
              <div class="mt-6 flex items-center justify-between">
                <p class="text-sm font-semibold text-white">Reproducidas últimamente</p>
                <span class="text-[10px] text-mint-300">Ver todo</span>
              </div>
              <ul class="mt-3 space-y-3">
                {
                  tracks.map((track) => (
                    <li class="flex items-center gap-3">
                      <span class="h-9 w-9 shrink-0 rounded-lg" style={`background: ${track.gradient}`}></span>
                      <span class="min-w-0 flex-1">
                        <span class="block truncate text-xs font-medium text-slate-200">{track.title}</span>
                        <span class="block truncate text-[10px] text-slate-500">{track.artist}</span>
                      </span>
                      <span class="text-[10px] text-slate-500">{track.time}</span>
                    </li>
                  ))
                }
              </ul>

              <!-- Navegación inferior -->
              <div class="mt-6 flex items-center justify-around border-t border-white/5 pt-4 text-slate-500">
                <svg viewBox="0 0 24 24" class="h-4 w-4 text-mint-400" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m3 10 9-7 9 7v10a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V10Z" /><path d="M9 22V12h6v10" /></svg>
                <svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="7" /><path d="m20 20-3.5-3.5" /></svg>
                <svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 6h16M4 12h16M4 18h10" /></svg>
                <svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 21s-8-4.7-8-11a4.5 4.5 0 0 1 8-2.8A4.5 4.5 0 0 1 20 10c0 6.3-8 11-8 11Z" /></svg>
              </div>
            </div>
          </div>

          <!-- Tarjetas flotantes -->
          <div class="absolute -right-6 top-14 hidden animate-float-slow items-center gap-3 rounded-2xl border border-white/10 bg-ink-800/95 px-4 py-3 shadow-2xl backdrop-blur sm:flex">
            <span class="grid h-9 w-9 place-items-center rounded-xl bg-mint-400/15 text-mint-300">
              <svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M3 12h2l3-7 4 14 3-7h6" /></svg>
            </span>
            <span>
              <span class="block text-[11px] font-semibold text-white">Audio Hi-Fi</span>
              <span class="block text-[10px] text-slate-400">24-bit / 192 kHz</span>
            </span>
          </div>

          <div class="absolute -left-8 bottom-16 hidden animate-float items-center gap-3 rounded-2xl border border-white/10 bg-ink-800/95 px-4 py-3 shadow-2xl backdrop-blur sm:flex">
            <span class="grid h-9 w-9 place-items-center rounded-xl bg-violet-neon/15 text-violet-300">
              <svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3v12m0 0 4-4m-4 4-4-4M4 17v3h16v-3" /></svg>
            </span>
            <span>
              <span class="block text-[11px] font-semibold text-white">Modo offline</span>
              <span class="block text-[10px] text-slate-400">128 canciones guardadas</span>
            </span>
          </div>
        </div>
      </div>
    </section>

    <!-- Características -->
    <section id="caracteristicas" class="scroll-mt-20 py-20 sm:py-24">
      <div class="mx-auto max-w-6xl px-5 sm:px-8">
        <div class="max-w-2xl">
          <p class="text-xs font-semibold uppercase tracking-[0.2em] text-mint-400">Características</p>
          <h2 class="mt-3 text-3xl font-bold leading-tight tracking-tight text-white sm:text-4xl">
            Diseñado para que solo escuches música.
          </h2>
          <p class="mt-4 text-slate-400">
            Cada detalle de Mis Canciones está pensado para una experiencia de escucha rápida, limpia y completamente tuya.
          </p>
        </div>

        <div class="mt-12 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
          {
            features.map((feature) => (
              <article class="card-surface group rounded-2xl border border-white/8 p-6 transition duration-300 hover:-translate-y-1 hover:border-mint-400/30 hover:shadow-[0_24px_50px_-28px_rgba(52,211,153,0.45)]">
                <div class="grid h-11 w-11 place-items-center rounded-xl border border-mint-400/20 bg-mint-400/10 text-mint-300 transition-colors group-hover:bg-mint-400/20">
                  <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    {feature.paths.map((path) => <path d={path} />)}
                  </svg>
                </div>
                <h3 class="mt-5 text-base font-semibold text-white">{feature.title}</h3>
                <p class="mt-2 text-sm leading-relaxed text-slate-400">{feature.description}</p>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <!-- Descarga -->
    <section id="descargar" class="scroll-mt-20 py-10 sm:py-16">
      <div class="mx-auto max-w-6xl px-5 sm:px-8">
        <div class="relative overflow-hidden rounded-3xl border border-white/10 bg-gradient-to-br from-ink-800 via-ink-900 to-ink-950 p-8 sm:p-12">
          <div class="absolute -right-20 -top-24 h-72 w-72 rounded-full bg-violet-neon/20 blur-3xl"></div>
          <div class="absolute -bottom-24 left-10 h-64 w-64 rounded-full bg-mint-400/10 blur-3xl"></div>

          <div class="relative grid gap-8 lg:grid-cols-[1fr_auto] lg:items-center">
            <div>
              <p class="text-xs font-semibold uppercase tracking-[0.2em] text-mint-400">Empieza ahora</p>
              <h2 class="mt-3 text-3xl font-bold tracking-tight text-white sm:text-4xl">Lleva tu música contigo.</h2>
              <p class="mt-4 max-w-xl text-slate-400">
                Elige tu plataforma e instala Mis Canciones en menos de un minuto. Tu biblioteca te espera.
              </p>
            </div>

            <div class="flex flex-wrap gap-3">
              <a href="#" class="inline-flex items-center gap-2 rounded-full bg-gradient-to-r from-mint-400 to-violet-neon px-5 py-3 text-sm font-semibold text-ink-950 shadow-lg shadow-mint-400/15 transition hover:brightness-110">
                <svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3v12m0 0 4-4m-4 4-4-4M4 17v3h16v-3" /></svg>
                Android
              </a>
              <a href="#" class="inline-flex items-center gap-2 rounded-full border border-white/10 bg-white/5 px-5 py-3 text-sm font-semibold text-white transition hover:border-white/25 hover:bg-white/10">
                <svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="4" width="20" height="13" rx="2" /><path d="M8 21h8m-4-4v4" /></svg>
                Windows
              </a>
              <a href="#" class="inline-flex items-center gap-2 rounded-full border border-white/10 bg-white/5 px-5 py-3 text-sm font-semibold text-white transition hover:border-white/25 hover:bg-white/10">
                <svg viewBox="0 0 24 24" class="h-4 w-4" fill="currentColor" aria-hidden="true"><path d="M16.4 12.7c0-2.4 2-3.6 2.1-3.7-1.1-1.7-2.9-1.9-3.6-1.9-1.5-.2-3 .9-3.7.9-.8 0-1.9-.9-3.2-.9-1.6 0-3.2 1-4 2.4-1.7 3-.4 7.4 1.2 9.8.8 1.2 1.8 2.5 3.1 2.4 1.2 0 1.7-.8 3.2-.8s1.9.8 3.2.8c1.3 0 2.2-1.2 3-2.4.9-1.4 1.3-2.7 1.3-2.8-.1 0-2.4-.9-2.4-3.8ZM14.2 5.4c.7-.8 1.1-2 1-3.1-1 0-2.2.7-2.9 1.5-.6.7-1.2 1.9-1 3.1 1.1.1 2.2-.6 2.9-1.5Z" /></svg>
                macOS
              </a>
            </div>
          </div>

          <p class="relative mt-7 text-xs text-slate-500">
            Los enlaces son provisionales: sustitúyelos por los instaladores reales de tu aplicación.
          </p>
        </div>
      </div>
    </section>

    <!-- FAQ y requisitos -->
    <section id="faq" class="scroll-mt-20 py-20 sm:py-24">
      <div class="mx-auto grid max-w-6xl gap-12 px-5 sm:px-8 lg:grid-cols-[0.85fr_1.15fr]">
        <div>
          <p class="text-xs font-semibold uppercase tracking-[0.2em] text-mint-400">Preguntas frecuentes</p>
          <h2 class="mt-3 text-3xl font-bold leading-tight tracking-tight text-white sm:text-4xl">
            Todo lo que quieres saber.
          </h2>
          <p class="mt-4 text-slate-400">Respuestas rápidas antes de descargar.</p>

          <div class="card-surface mt-8 rounded-2xl border border-white/8 p-6">
            <h3 class="flex items-center gap-2 text-sm font-semibold text-white">
              <svg viewBox="0 0 24 24" class="h-4 w-4 text-mint-400" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="3" width="20" height="14" rx="2" /><path d="M8 21h8m-4-4v4" /></svg>
              Requisitos del sistema
            </h3>
            <ul class="mt-4 space-y-3">
              {
                requirements.map((item) => (
                  <li class="flex items-start justify-between gap-4 border-b border-white/5 pb-3 text-sm last:border-0 last:pb-0">
                    <span class="font-medium text-slate-200">{item.platform}</span>
                    <span class="text-right text-xs text-slate-500">{item.detail}</span>
                  </li>
                ))
              }
            </ul>
          </div>
        </div>

        <div class="space-y-3">
          {
            faqs.map((faq) => (
              <details class="card-surface group rounded-2xl border border-white/8 px-5 py-4 transition-colors open:border-mint-400/25">
                <summary class="flex cursor-pointer list-none items-center justify-between gap-4 text-sm font-semibold text-white [&::-webkit-details-marker]:hidden">
                  {faq.question}
                  <svg viewBox="0 0 24 24" class="h-5 w-5 shrink-0 text-slate-400 transition-transform duration-200 group-open:rotate-45" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M12 5v14M5 12h14" /></svg>
                </summary>
                <p class="mt-3 max-w-2xl text-sm leading-relaxed text-slate-400">{faq.answer}</p>
              </details>
            ))
          }
        </div>
      </div>
    </section>
  </main>

  <!-- Footer -->
  <footer class="border-t border-white/5 py-10">
    <div class="mx-auto flex max-w-6xl flex-col gap-6 px-5 sm:px-8 md:flex-row md:items-center md:justify-between">
      <a href="/" class="flex items-center gap-2.5">
        <span class="grid h-8 w-8 place-items-center rounded-lg bg-gradient-to-br from-mint-400 to-violet-neon">
          <svg viewBox="0 0 24 24" class="h-4 w-4 text-ink-950" fill="currentColor" aria-hidden="true"><path d="M19 3v12.5a3.5 3.5 0 1 1-2-3.16V7l-8 2v9.5a3.5 3.5 0 1 1-2-3.16V6l11-3Z" /></svg>
        </span>
        <span class="text-sm font-semibold text-white">Mis Canciones</span>
      </a>

      <nav class="flex flex-wrap gap-x-6 gap-y-2 text-sm text-slate-500" aria-label="Enlaces legales">
        <a href="#privacidad" class="transition-colors hover:text-white">Privacidad</a>
        <a href="#terminos" class="transition-colors hover:text-white">Términos</a>
        <a href="#contacto" class="transition-colors hover:text-white">Contacto</a>
      </nav>

      <p class="text-sm text-slate-500">© {year} Mis Canciones. Todos los derechos reservados.</p>
    </div>
  </footer>
</BaseLayout>
