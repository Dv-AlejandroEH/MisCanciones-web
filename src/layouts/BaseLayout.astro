---
import { withBase } from '../utils/assets';
import '../styles/global.css';
import { app } from '../data/app';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  structuredData?: Record<string, unknown>;
}

const {
  title = `${app.name} — ${app.tagline}`,
  description = app.valueProposition,
  image = withBase('og-image.png'),
  structuredData,
} = Astro.props;

const base = Astro.site ?? new URL(Astro.url.origin);
const canonicalURL = new URL(Astro.url.pathname, base).toString();
const ogImage = new URL(image, base).toString();
const siteName = app.name;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <link rel="canonical" href={canonicalURL} />
    <meta name="theme-color" content="#0A0A0A" />
    <meta name="color-scheme" content="dark light" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <link rel="icon" href={withBase('favicon.ico')} sizes="any" />
    <link rel="icon" type="image/png" sizes="64x64" href={withBase('favicon.png')} />
    <link rel="apple-touch-icon" href={withBase('apple-touch-icon.png')} />
    <link rel="sitemap" type="application/xml" href={withBase('sitemap-index.xml')} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:secure_url" content={ogImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${app.name} — ${app.tagline}`} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={`Interfaz de ${app.name}`} />

    {
      structuredData && (
        <script type="application/ld+json" is:inline set:html={JSON.stringify(structuredData)} />
      )
    }
  </head>
  <body>
    <div class="scroll-progress" aria-hidden="true"></div>
    <slot />

    <script>
      import { downloadOptions, findDownload, type DownloadId } from '../data/downloads';
      import { detectEnvironment } from '../utils/platform';

      const root = document.documentElement;
      const clamp = (value: number) => Math.min(1, Math.max(0, value));
      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      const nav = document.querySelector<HTMLElement>('[data-nav]');
      const dock = document.querySelector<HTMLElement>('[data-dock]');
      const hero = document.querySelector<HTMLElement>('[data-hero]');
      const heroCopy = document.querySelector<HTMLElement>('[data-hero-copy]');
      const story = document.querySelector<HTMLElement>('[data-story]');
      const storyLines = Array.from(
        story?.querySelectorAll<HTMLElement>('[data-story-line]') ?? [],
      );
      const storyPhone = story?.querySelector<HTMLElement>('[data-story-phone]');
      const storyFinal = story?.querySelector<HTMLElement>('[data-story-final]');
      const storySources = Array.from(
        story?.querySelectorAll<HTMLElement>('[data-source]') ?? [],
      );
      const storySteps = Array.from(
        story?.querySelectorAll<HTMLElement>('.story-steps i') ?? [],
      );

      let queued = false;

      const updateScroll = () => {
        const viewport = window.innerHeight || 1;
        const scrollY = window.scrollY;
        const maxScroll = root.scrollHeight - viewport;

        root.style.setProperty(
          '--page-progress',
          (maxScroll > 0 ? clamp(scrollY / maxScroll) : 0).toFixed(4),
        );

        nav?.classList.toggle('is-scrolled', scrollY > 24);

        if (dock && hero) {
          const rect = hero.getBoundingClientRect();
          dock.classList.toggle('is-visible', rect.bottom < viewport * 0.42);
        }

        if (!reduceMotion && hero && heroCopy) {
          const rect = hero.getBoundingClientRect();
          const progress = clamp(1 - Math.max(0, -rect.top) / ((rect.height || viewport) * 0.8));
          heroCopy.style.setProperty('--hero-fade', progress.toFixed(3));
        }

        if (!reduceMotion && story) {
          const rect = story.getBoundingClientRect();
          const travel = Math.max(1, rect.height - viewport);
          const p = clamp(-rect.top / travel);
          const stageWidth = story.clientWidth || window.innerWidth;

          // 1 → 2: crossfade entre las dos preguntas.
          const lineA = storyLines.find((line) => line.dataset.storyLine === 'a');
          const lineB = storyLines.find((line) => line.dataset.storyLine === 'b');
          lineA?.style.setProperty('--line-op', clamp(1 - p / 0.17).toFixed(3));
          lineB?.style.setProperty(
            '--line-op',
            (clamp((p - 0.1) / 0.12) * clamp(1 - (p - 0.48) / 0.12)).toFixed(3),
          );

          // 3: las fuentes vuelan hacia el teléfono con estela luminosa.
          const fly = clamp((p - 0.28) / 0.32);
          storySources.forEach((source) => {
            source.style.setProperty('--fly', (1 - fly).toFixed(3));
            source.style.setProperty('--source-op', Math.max(0, 1 - fly * 1.12).toFixed(3));
          });

          if (storyPhone) {
            const appear = clamp((p - 0.16) / 0.16);
            const shift = clamp((p - 0.58) / 0.2);
            storyPhone.style.setProperty('--phone-op', appear.toFixed(3));
            storyPhone.style.setProperty('--phone-s', (0.88 + 0.12 * appear).toFixed(3));
            storyPhone.style.setProperty('--phone-x', `${Math.round(-stageWidth * 0.2 * shift)}px`);
          }

          // 4: el teléfono a la izquierda, el cierre a la derecha.
          storyFinal?.style.setProperty('--final-op', clamp((p - 0.62) / 0.16).toFixed(3));

          const step = p < 0.16 ? 0 : p < 0.3 ? 1 : p < 0.62 ? 2 : 3;
          storySteps.forEach((item, index) => item.classList.toggle('on', index <= step));
        }

        queued = false;
      };

      const onScroll = () => {
        if (queued) return;
        queued = true;
        requestAnimationFrame(updateScroll);
      };

      window.addEventListener('scroll', onScroll, { passive: true });
      window.addEventListener('resize', onScroll);
      updateScroll();

      // Revelados suaves al entrar en pantalla.
      const reveals = Array.from(document.querySelectorAll<HTMLElement>('[data-reveal]'));
      if (reduceMotion || !('IntersectionObserver' in window)) {
        reveals.forEach((element) => element.classList.add('is-visible'));
      } else {
        const revealObserver = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                revealObserver.unobserve(entry.target);
              }
            });
          },
          { threshold: 0.12 },
        );
        reveals.forEach((element) => revealObserver.observe(element));
      }

      // Contador: 0 → 100% al entrar en pantalla.
      const counter = document.querySelector<HTMLElement>('[data-counter]');
      if (counter) {
        const target = Number(counter.dataset.countTo ?? 0);
        const suffix = counter.dataset.suffix ?? '';
        const render = (value: number) => {
          counter.textContent = `${value.toLocaleString('es-ES')}${suffix}`;
        };
        if (reduceMotion || !('IntersectionObserver' in window)) {
          render(target);
        } else {
          const counterObserver = new IntersectionObserver(
            (entries) => {
              if (!entries.some((entry) => entry.isIntersecting)) return;
              counterObserver.disconnect();
              const duration = 1400;
              const start = performance.now();
              const tick = (now: number) => {
                const t = clamp((now - start) / duration);
                const eased = 1 - Math.pow(1 - t, 3);
                render(Math.round(target * eased));
                if (t < 1) requestAnimationFrame(tick);
              };
              requestAnimationFrame(tick);
            },
            { threshold: 0.5 },
          );
          counterObserver.observe(counter);
        }
      }

      // Demo interactiva: pasos clicables + recorrido automático al verla.
      const demo = document.querySelector<HTMLElement>('[data-demo]');
      if (demo) {
        const buttons = Array.from(
          demo.querySelectorAll<HTMLButtonElement>('[data-demo-step]'),
        );
        const screens = Array.from(
          demo.querySelectorAll<HTMLElement>('[data-demo-screen]'),
        );
        const toast = demo.querySelector<HTMLElement>('[data-demo-toast]');
        let active = 0;
        let timer: number | undefined;
        let toastTimer: number | undefined;

        const setStep = (index: number, notify = true) => {
          active = index;
          buttons.forEach((button, i) => {
            button.classList.toggle('active', i === index);
            button.setAttribute('aria-pressed', i === index ? 'true' : 'false');
          });
          screens.forEach((screen, i) => {
            screen.hidden = i !== index;
          });
          if (notify && toast && !reduceMotion) {
            toast.classList.add('is-visible');
            window.clearTimeout(toastTimer);
            toastTimer = window.setTimeout(() => toast.classList.remove('is-visible'), 1800);
          }
        };

        buttons.forEach((button) => {
          button.addEventListener('click', () => {
            window.clearInterval(timer);
            setStep(Number(button.dataset.demoStep ?? 0));
          });
        });

        if (!reduceMotion && 'IntersectionObserver' in window) {
          const demoObserver = new IntersectionObserver(
            (entries) => {
              if (entries.some((entry) => entry.isIntersecting)) {
                window.clearInterval(timer);
                timer = window.setInterval(() => setStep((active + 1) % 3), 2600);
              } else {
                window.clearInterval(timer);
              }
            },
            { threshold: 0.35 },
          );
          demoObserver.observe(demo);
        }
      }

      // Motor de recomendación compartido por hero, navbar, dock y descargas.
      const downloadRoot = document.querySelector<HTMLElement>('[data-downloads]');
      const uaData = (navigator as Navigator & {
        userAgentData?: { platform?: string };
      }).userAgentData;
      const environment = detectEnvironment(navigator.userAgent, uaData?.platform ?? '');
      const validIds = new Set<string>(downloadOptions.map((option) => option.id));
      let storedId: string | null = null;
      try {
        storedId = window.sessionStorage.getItem('miscanciones-download');
      } catch {
        // El modo privado puede bloquear sessionStorage; usamos la detección.
      }
      let recommendedId: DownloadId =
        storedId && validIds.has(storedId)
          ? (storedId as DownloadId)
          : environment.recommendation;

      const localized = (es: string, en: string) => (root.lang === 'en' ? en : es);
      const tabFor = (id: DownloadId): 'android' | 'linux' | 'web' => {
        if (id === 'android') return 'android';
        if (id === 'web') return 'web';
        return 'linux';
      };
      const setLabel = (element: HTMLElement | null, es: string, en: string) => {
        if (!element) return;
        element.dataset.es = es;
        element.dataset.en = en;
        element.textContent = localized(es, en);
      };

      const applyRecommendation = (id: DownloadId) => {
        recommendedId = id;
        try {
          window.sessionStorage.setItem('miscanciones-download', id);
        } catch {
          // Sin persistencia: la elección sigue activa mientras dure la página.
        }

        const option = findDownload(id);

        // CTAs globales (hero, navbar, dock, footer).
        document.querySelectorAll<HTMLElement>('[data-smart-download]').forEach((link) => {
          link.setAttribute('href', option.href);
          if (option.file) link.setAttribute('download', option.file);
          else link.removeAttribute('download');
          if (option.external) {
            link.setAttribute('target', '_blank');
            link.setAttribute('rel', 'noopener');
          } else {
            link.removeAttribute('target');
            link.removeAttribute('rel');
          }
          setLabel(link.querySelector<HTMLElement>('[data-smart-label]'), option.labelEs, option.labelEn);
          setLabel(link.querySelector<HTMLElement>('[data-smart-detail]'), option.detailEs, option.detailEn);
          const icon = link.querySelector<HTMLElement>('[data-smart-icon]');
          if (icon) icon.textContent = option.external ? '↗' : '↓';
        });

        // Chips y tarjetas de la sección de descargas.
        document.querySelectorAll<HTMLElement>('[data-recommend]').forEach((chip) => {
          const active = chip.dataset.recommend === id;
          chip.classList.toggle('is-active', active);
          chip.setAttribute('aria-pressed', active ? 'true' : 'false');
        });
        document.querySelectorAll<HTMLElement>('[data-download-card]').forEach((card) => {
          card.classList.toggle('is-recommended', card.dataset.downloadCard === id);
        });

        // La tarjeta destacada de Linux se adapta a la distro elegida.
        const featureOption = option.group === 'linux' ? option : findDownload('appimage');
        setLabel(
          downloadRoot?.querySelector<HTMLElement>('[data-feature-title]') ?? null,
          featureOption.featureTitleEs ?? featureOption.titleEs,
          featureOption.featureTitleEn ?? featureOption.titleEn,
        );
        setLabel(
          downloadRoot?.querySelector<HTMLElement>('[data-feature-text]') ?? null,
          featureOption.featureTextEs ?? featureOption.descriptionEs,
          featureOption.featureTextEn ?? featureOption.descriptionEn,
        );
        const featureLink = downloadRoot?.querySelector<HTMLElement>('[data-feature-download]');
        if (featureLink) {
          featureLink.setAttribute('href', featureOption.href);
          featureLink.setAttribute('download', featureOption.file);
          setLabel(
            featureLink.querySelector<HTMLElement>('[data-smart-label]'),
            featureOption.labelEs,
            featureOption.labelEn,
          );
          setLabel(
            featureLink.querySelector<HTMLElement>('[data-smart-detail]'),
            featureOption.detailEs,
            featureOption.detailEn,
          );
        }
        const featureCopy = downloadRoot?.querySelector<HTMLButtonElement>('[data-feature-copy]');
        if (featureCopy && featureOption.command) {
          featureCopy.dataset.copy = featureOption.command;
        }
        const featureCommand = downloadRoot?.querySelector<HTMLElement>('[data-feature-command]');
        if (featureCommand && featureOption.command) {
          featureCommand.textContent = featureOption.command;
        }

        const detected = downloadRoot?.querySelector<HTMLElement>('[data-download-detected]');
        if (detected) {
          let es = 'Sin instalación nativa · usa la web';
          let en = 'No native build · use the web';
          if (environment.os === 'android') {
            es = 'Android detectado · APK';
            en = 'Android detected · APK';
          } else if (environment.distro === 'Ubuntu' || environment.distro === 'Debian') {
            es = `${environment.distro} detectado · paquete .deb`;
            en = `${environment.distro} detected · .deb package`;
          } else if (environment.distro === 'Fedora' || environment.distro === 'RHEL') {
            es = `${environment.distro} detectado · paquete .rpm`;
            en = `${environment.distro} detected · .rpm package`;
          } else if (environment.os === 'linux') {
            es = 'Linux detectado · AppImage';
            en = 'Linux detected · AppImage';
          }
          setLabel(detected, es, en);
        }
      };

      if (downloadRoot) {
        const downloadTabs = Array.from(
          downloadRoot.querySelectorAll<HTMLButtonElement>('[data-download-tab]'),
        );
        const downloadPanels = Array.from(
          downloadRoot.querySelectorAll<HTMLElement>('[data-download-panel]'),
        );
        const activateDownload = (id: string) => {
          downloadTabs.forEach((tab) => {
            const active = tab.dataset.downloadTab === id;
            tab.classList.toggle('is-active', active);
            tab.setAttribute('aria-selected', active ? 'true' : 'false');
          });
          downloadPanels.forEach((panel) => {
            panel.hidden = panel.dataset.downloadPanel !== id;
          });
        };

        applyRecommendation(recommendedId);
        activateDownload(tabFor(recommendedId));

        downloadTabs.forEach((tab) => {
          tab.addEventListener('click', () => {
            const tabId = tab.dataset.downloadTab ?? 'web';
            activateDownload(tabId);
            if (tabId === 'android') applyRecommendation('android');
            else if (tabId === 'web') applyRecommendation('web');
            else if (findDownload(recommendedId).group !== 'linux') {
              applyRecommendation('appimage');
            }
          });
        });
        downloadRoot.querySelectorAll<HTMLElement>('[data-download-jump]').forEach((jump) => {
          jump.addEventListener('click', () => {
            const tabId = jump.dataset.downloadJump ?? 'android';
            activateDownload(tabId);
            applyRecommendation(tabId === 'android' ? 'android' : tabId === 'web' ? 'web' : 'appimage');
            downloadRoot.scrollIntoView({
              behavior: reduceMotion ? 'auto' : 'smooth',
              block: 'start',
            });
          });
        });
        downloadRoot.querySelectorAll<HTMLButtonElement>('[data-recommend]').forEach((chip) => {
          chip.addEventListener('click', () => {
            const id = chip.dataset.recommend as DownloadId | undefined;
            if (!id || !validIds.has(id)) return;
            applyRecommendation(id);
            activateDownload(tabFor(id));
          });
        });
      }

      // Botones «copiar comando» de las guías de instalación.
      document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((button) => {
        button.addEventListener('click', async () => {
          const text = button.dataset.copy ?? '';
          try {
            if (navigator.clipboard?.writeText) {
              await navigator.clipboard.writeText(text);
            } else {
              const input = document.createElement('textarea');
              input.value = text;
              input.style.position = 'fixed';
              input.style.opacity = '0';
              document.body.appendChild(input);
              input.select();
              const legacyDocument = document as unknown as {
                execCommand: (commandId: string) => boolean;
              };
              legacyDocument.execCommand('copy');
              input.remove();
            }

            const label = button.querySelector<HTMLElement>('[data-copy-label]');
            const copiedEs = button.dataset.copyEs ?? '¡Copiado!';
            const copiedEn = button.dataset.copyEn ?? 'Copied!';
            const originalEs = label?.dataset.es ?? label?.textContent ?? '';
            const originalEn = label?.dataset.en ?? originalEs;

            button.classList.add('is-copied');
            if (label) {
              label.dataset.es = copiedEs;
              label.dataset.en = copiedEn;
              label.textContent = root.lang === 'en' ? copiedEn : copiedEs;
            }

            window.setTimeout(() => {
              button.classList.remove('is-copied');
              if (label) {
                label.dataset.es = originalEs;
                label.dataset.en = originalEn;
                label.textContent = root.lang === 'en' ? originalEn : originalEs;
              }
            }, 1800);
          } catch {
            // Si el navegador bloquea el portapapeles, el comando sigue visible para copiar a mano.
          }
        });
      });

      // Selector ES / EN para las etiquetas cortas.
      const langButton = document.querySelector<HTMLButtonElement>('[data-lang]');
      langButton?.addEventListener('click', () => {
        const next = root.lang === 'es' ? 'en' : 'es';
        root.lang = next;
        langButton.textContent = next.toUpperCase();
        document.querySelectorAll<HTMLElement>('[data-en]').forEach((element) => {
          if (element.children.length > 0) return;
          if (!element.dataset.es) element.dataset.es = element.textContent ?? '';
          element.textContent = next === 'en' ? element.dataset.en ?? element.dataset.es : element.dataset.es;
        });
      });

      // Menú móvil.
      const menuButton = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
      const menu = document.querySelector<HTMLElement>('[data-menu]');
      menuButton?.addEventListener('click', () => {
        if (!menu) return;
        menu.hidden = !menu.hidden;
        menuButton.setAttribute('aria-expanded', menu.hidden ? 'false' : 'true');
      });
      menu?.querySelectorAll('a').forEach((link) => {
        link.addEventListener('click', () => {
          if (!menu) return;
          menu.hidden = true;
          menuButton?.setAttribute('aria-expanded', 'false');
        });
      });
    </script>
  </body>
</html>
